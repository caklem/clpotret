---
import { site } from '../data/site';
import { graduationPackages, generalPackages } from '../data/pricing';
---
<form id="booking-form" data-phone={site.whatsapp}>
  <div class="field"><label for="name">Nama *</label><input id="name" name="name" required placeholder="Nama lengkap" /></div>
  <div class="field"><label for="phone">Nomor WhatsApp *</label><input id="phone" name="phone" required inputmode="tel" placeholder="08xxxxxxxxxx" /></div>
  <div class="field"><label for="instagram">Instagram</label><input id="instagram" name="instagram" placeholder="@username" /></div>
  <div class="field"><label for="session">Jenis sesi *</label><select id="session" name="session" required><option value="">Pilih jenis sesi</option><option value="Graduation Photography">Graduation Photography</option><option value="Personal / Hunting">Personal / Hunting</option><option value="Couple / Bestie">Couple / Bestie</option><option value="Event / Documentation">Event / Documentation</option><option value="Travel / Outdoor Session">Travel / Outdoor Session</option></select></div>
  <div class="field"><label for="package">Paket</label><select id="package" name="package"><option value="">Belum memilih</option><optgroup label="Graduation">{graduationPackages.map(p => <option value={p.id}>{p.name} — {p.price}</option>)}</optgroup><optgroup label="General">{generalPackages.map(p => <option value={p.id}>{p.name} — {p.price}</option>)}</optgroup></select></div>
  <div class="field"><label for="date">Tanggal *</label><input id="date" name="date" type="date" required /></div>
  <div class="field"><label for="time">Jam</label><input id="time" name="time" type="time" /></div>
  <div class="field"><label for="location">Lokasi</label><input id="location" name="location" placeholder="Kampus / area pilihan" /></div>
  <div class="field"><label for="people">Jumlah orang</label><input id="people" name="people" type="number" min="1" placeholder="1" /></div>
  <div class="field full"><label for="notes">Catatan / konsep foto</label><textarea id="notes" name="notes" rows="5" placeholder="Ceritakan suasana atau referensi yang kamu inginkan..."></textarea></div>
  <div class="full submission-error" id="submission-error" hidden>Pengiriman gagal. Silakan coba lagi.</div>
  <div class="full action"><p>Data tidak disimpan. Kamu akan diarahkan ke WhatsApp dengan pesan yang sudah tersusun.</p><button class="button" type="submit">Continue via WhatsApp <span>↗</span></button></div>
</form>
<script>
  const setupBooking = () => {
    const form = document.querySelector<HTMLFormElement>('#booking-form');
    if (!form) return;
    const query = new URLSearchParams(location.search);
    const packageSelect = form.elements.namedItem('package') as HTMLSelectElement;
    const sessionSelect = form.elements.namedItem('session') as HTMLSelectElement;
    const packageValue = query.get('package');

    // Auto-select package and session from query param
    if (packageValue) {
      packageSelect.value = packageValue;
      // Auto-detect session from package ID
      if (packageValue.includes('graduation') || packageValue === 'basic-graduation') {
        sessionSelect.value = 'Graduation Photography';
      } else if (packageValue === 'personal-hunting') {
        sessionSelect.value = 'Personal / Hunting';
      } else if (packageValue === 'couple-bestie') {
        sessionSelect.value = 'Couple / Bestie';
      } else if (packageValue === 'event-documentation') {
        sessionSelect.value = 'Event / Documentation';
      } else if (packageValue === 'travel-outdoor') {
        sessionSelect.value = 'Travel / Outdoor Session';
      }
    }

    form.onsubmit = async (e) => {
      e.preventDefault();
      const errorEl = document.getElementById('submission-error');
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (errorEl) errorEl.hidden = true;
      if (submitButton) submitButton.disabled = true;
      const data = new FormData(form);
      const get = (k: string) => data.get(k) || '-';
      const message = `Halo CL Potret 📸\n\nSaya ingin melakukan booking sesi foto.\n\nNama: ${get('name')}\nNomor WhatsApp: ${get('phone')}\nInstagram: ${get('instagram')}\nJenis Sesi: ${get('session')}\nPaket: ${get('package')}\nTanggal: ${get('date')}\nJam: ${get('time')}\nLokasi: ${get('location')}\nJumlah Orang: ${get('people')}\nCatatan: ${get('notes')}\n\nApakah jadwal tersebut tersedia?`;

      // Send to Fonte through the rate-limited server-side API.
      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: get('name'),
            phone: get('phone'),
            instagram: get('instagram'),
            session: get('session'),
            package: get('package'),
            date: get('date'),
            time: get('time'),
            location: get('location'),
            people: get('people'),
            notes: get('notes'),
          }),
        });

        if (!res.ok) {
          if (errorEl) {
            const retryAfter = Number(res.headers.get('Retry-After'));
            errorEl.textContent = res.status === 429
              ? `Terlalu banyak percobaan. Coba lagi dalam ${Number.isFinite(retryAfter) ? retryAfter : 60} detik.`
              : 'Pengiriman gagal. Silakan coba lagi.';
            errorEl.hidden = false;
          }
          return;
        }
      } catch (err) {
        console.error('Fonte error:', err);
        if (errorEl) {
          errorEl.textContent = 'Pengiriman gagal. Periksa koneksi dan coba lagi.';
          errorEl.hidden = false;
        }
        return;
      } finally {
        if (submitButton) submitButton.disabled = false;
      }

      // Open WhatsApp
      window.open(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    };
  };
  document.addEventListener('astro:page-load', setupBooking);
  setupBooking();
</script>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.2rem 1.5rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: .7rem;
  }
  .full {
    grid-column: 1 / -1;
  }
  label {
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .13em;
    font-weight: 600;
  }
  input, select, textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid #aaa397;
    border-radius: 0;
    padding: .8rem 0;
    outline: none;
    color: #1d1c19;
  }
  input:focus, select:focus, textarea:focus {
    border-color: #1d1c19;
  }
  textarea {
    border: 1px solid #aaa397;
    padding: 1rem;
    resize: vertical;
  }
  .submission-error {
    font-size: .78rem;
    color: #b54a4a;
    margin-top: -1rem;
  }
  .action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }
  .action p {
    font-size: .72rem;
    color: #777268;
    max-width: 360px;
    line-height: 1.6;
  }
  .action span {
    margin-left: 1rem;
  }
  @media (max-width: 650px) {
    form {
      grid-template-columns: 1fr;
    }
    .full {
      grid-column: auto;
    }
    .action {
      align-items: stretch;
      flex-direction: column;
      gap: 1.5rem;
    }
    .action .button {
      width: 100%;
    }
  }
</style>
