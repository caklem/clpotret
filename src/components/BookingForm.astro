---
import { site } from '../data/site';
import { packages } from '../data/pricing';
---
<form id="booking-form" data-phone={site.whatsapp}>
  <div class="field"><label for="name">Nama *</label><input id="name" name="name" required placeholder="Nama lengkap" /></div>
  <div class="field"><label for="phone">Nomor WhatsApp *</label><input id="phone" name="phone" required inputmode="tel" placeholder="08xxxxxxxxxx" /></div>
  <div class="field"><label for="instagram">Instagram</label><input id="instagram" name="instagram" placeholder="@username" /></div>
  <div class="field"><label for="session">Jenis sesi *</label><select id="session" name="session" required><option value="">Pilih jenis sesi</option><option>Graduation Photography</option><option>Personal Portrait</option><option>Outdoor / Hunting</option><option>Couple Session</option><option>Family Session</option><option>Event Documentation</option><option>Creative Photography</option></select></div>
  <div class="field"><label for="package">Paket</label><select id="package" name="package"><option value="">Belum memilih</option>{packages.map(p => <option>{p.name}</option>)}<option>Paket lainnya</option></select></div>
  <div class="field"><label for="date">Tanggal *</label><input id="date" name="date" type="date" required /></div>
  <div class="field"><label for="time">Jam</label><input id="time" name="time" type="time" /></div>
  <div class="field"><label for="location">Lokasi</label><input id="location" name="location" placeholder="Kampus / area pilihan" /></div>
  <div class="field"><label for="people">Jumlah orang</label><input id="people" name="people" type="number" min="1" placeholder="1" /></div>
  <div class="field full"><label for="notes">Catatan / konsep foto</label><textarea id="notes" name="notes" rows="5" placeholder="Ceritakan suasana atau referensi yang kamu inginkan..."></textarea></div>
  <div class="full action"><p>Data tidak disimpan. Kamu akan diarahkan ke WhatsApp dengan pesan yang sudah tersusun.</p><button class="button" type="submit">Continue via WhatsApp <span>↗</span></button></div>
</form>
<script>
  const setupBooking=()=>{const form=document.querySelector<HTMLFormElement>('#booking-form');if(!form)return;const query=new URLSearchParams(location.search);const packageSelect=form.elements.namedItem('package') as HTMLSelectElement;const sessionSelect=form.elements.namedItem('session') as HTMLSelectElement;if(query.get('package'))packageSelect.value=query.get('package')||'';if(query.get('session'))sessionSelect.value=query.get('session')||'';form.onsubmit=(e)=>{e.preventDefault();const data=new FormData(form);const get=(k:string)=>data.get(k)||'-';const message=`Halo CL Potret 📸\n\nSaya ingin melakukan booking sesi foto.\n\nNama: ${get('name')}\nNomor WhatsApp: ${get('phone')}\nInstagram: ${get('instagram')}\nJenis Sesi: ${get('session')}\nPaket: ${get('package')}\nTanggal: ${get('date')}\nJam: ${get('time')}\nLokasi: ${get('location')}\nJumlah Orang: ${get('people')}\nCatatan: ${get('notes')}\n\nApakah jadwal tersebut tersedia?`;window.open(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`,'_blank','noopener,noreferrer')}};document.addEventListener('astro:page-load',setupBooking);setupBooking();
</script>
<style>form{display:grid;grid-template-columns:1fr 1fr;gap:2.2rem 1.5rem}.field{display:flex;flex-direction:column;gap:.7rem}.full{grid-column:1/-1}label{font-size:.68rem;text-transform:uppercase;letter-spacing:.13em;font-weight:600}input,select,textarea{background:transparent;border:0;border-bottom:1px solid #aaa397;border-radius:0;padding:.8rem 0;outline:none;color:#1d1c19}input:focus,select:focus,textarea:focus{border-color:#1d1c19}textarea{border:1px solid #aaa397;padding:1rem;resize:vertical}.action{display:flex;justify-content:space-between;align-items:center;margin-top:1rem}.action p{font-size:.72rem;color:#777268;max-width:360px;line-height:1.6}.action span{margin-left:1rem}@media(max-width:650px){form{grid-template-columns:1fr}.full{grid-column:auto}.action{align-items:stretch;flex-direction:column;gap:1.5rem}.action .button{width:100%}}</style>
