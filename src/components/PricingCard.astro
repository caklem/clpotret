---
import type { PricingPackage } from '../data/pricing';
interface Props {
  item: PricingPackage;
  index: number;
}
const { item, index } = Astro.props;
---
<article class="price" data-reveal>
  <span class="eyebrow">0{index + 1}</span>
  <h3 class="display">{item.name}</h3>
  {item.tagline && <p class="tagline">{item.tagline}</p>}
  <p class="amount">{item.price}</p>
  <ul>
    {item.features.map(x => <li>{x}</li>)}
  </ul>
  <a href={`/booking?package=${item.id}`} class="link-line">Book {item.name}</a>
</article>

<style>
  .price {
    border-top: 1px solid #1d1c19;
    padding: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
  }
  .price h3 {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    margin: 2rem 0 .3rem;
  }
  .tagline {
    font-size: .78rem;
    color: #9a7658;
    font-style: italic;
    margin: 0;
  }
  .amount {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin: 2rem 0;
    color: #1d1c19;
  }
  .price ul {
    list-style: none;
    padding: 1.5rem 0;
    margin: 0 0 2rem;
    border-top: 1px solid #1d1c1922;
    flex: 1;
  }
  .price li {
    padding: .42rem 0;
    font-size: .88rem;
  }
  .price li::before {
    content: '—';
    margin-right: .8rem;
    color: #9a7658;
  }
  .price a {
    margin-top: auto;
  }
</style>
