---
import { whatsappUrl } from '../data/site';
interface Props { transparent?: boolean; }
const { transparent = false } = Astro.props;
const nav = [['Portfolio','/portfolio'],['Services','/services'],['Pricing','/pricing'],['About','/#about'],['Contact','/#contact']];
---
<header class:list={['site-nav', { transparent }]} data-nav>
  <a href="/" class="logo" aria-label="CL Potret home"><span>CL</span> Potret</a>
  <nav aria-label="Main navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  <a class="book" href="/booking">Booking Session</a>
  <button class="menu" aria-label="Buka menu" aria-expanded="false">Menu</button>
</header>
<div class="mobile-panel" data-panel>
  <nav>{nav.map(([label, href], i) => <a href={href}><small>0{i + 1}</small>{label}</a>)}</nav>
  <a href="/booking" class="button">Booking Session</a>
  <a href={whatsappUrl()} class="wa">WhatsApp ↗</a>
</div>
<script>
  const setupNav = () => {
    const nav = document.querySelector<HTMLElement>('[data-nav]'); const panel = document.querySelector<HTMLElement>('[data-panel]'); const button = nav?.querySelector<HTMLButtonElement>('.menu');
    if (!nav || !panel || !button) return;
    const update = () => nav.classList.toggle('scrolled', window.scrollY > 24); update(); window.addEventListener('scroll', update, { passive: true });
    button.onclick = () => { const open = panel.classList.toggle('open'); button.setAttribute('aria-expanded', String(open)); document.body.style.overflow = open ? 'hidden' : ''; };
    panel.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { panel.classList.remove('open'); document.body.style.overflow = ''; }));
  }; document.addEventListener('astro:page-load', setupNav); setupNav();
</script>
<style>
  .site-nav{position:fixed;z-index:50;top:0;left:0;width:100%;height:76px;padding:0 clamp(1rem,3vw,3rem);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:rgba(243,240,233,.96);transition:.3s;color:#1d1c19}.site-nav.transparent:not(.scrolled){color:white;background:transparent}.site-nav.scrolled{height:66px;backdrop-filter:blur(10px);box-shadow:0 1px rgba(29,28,25,.08)}
  .logo{font-family:var(--font-display);font-size:1.35rem;letter-spacing:-.03em}.logo span{font-family:var(--font-sans);font-size:.68rem;letter-spacing:.06em;border:1px solid currentColor;padding:.25rem;margin-right:.35rem}
  nav{display:flex;gap:2rem}nav a,.book{font-size:.68rem;letter-spacing:.13em;text-transform:uppercase}.book{justify-self:end;border-bottom:1px solid;padding-bottom:.3rem}.menu{display:none;background:none;border:0;color:inherit;padding:8px 0;justify-self:end;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;border-bottom:1px solid currentColor}
  .mobile-panel{display:none}
  @media(max-width:800px){.site-nav{height:65px;grid-template-columns:1fr auto}.site-nav>nav,.site-nav>.book{display:none}.menu{display:block}.mobile-panel{display:flex;position:fixed;z-index:40;inset:0;background:#24231f;color:#f3f0e9;padding:8rem 1.25rem 2rem;flex-direction:column;justify-content:space-between;transform:translateY(-105%);transition:transform .45s cubic-bezier(.76,0,.24,1)}.mobile-panel.open{transform:none}.mobile-panel nav{display:flex;flex-direction:column;gap:0}.mobile-panel nav a{font-family:var(--font-display);font-size:clamp(2.5rem,13vw,4.5rem);border-bottom:1px solid #ffffff25;padding:.18em 0;display:flex;align-items:center;gap:1rem}.mobile-panel small{font-family:var(--font-sans);font-size:.6rem;letter-spacing:.12em}.mobile-panel .button{margin-top:2rem}.wa{text-align:center;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase}}
</style>
