---
interface Props {
  class?: string;
  loading?: 'eager' | 'lazy';
  size?: string;
}

const { class: className, loading = 'lazy', size = '4rem' } = Astro.props;
---

<img class:list={['brand-logo', className]} src="/IMG/Logo.png?v=4" alt="CL Potret" width="120" height="120" loading={loading} decoding="async" style={`width:${size};height:auto`} />

<style>
  .brand-logo {
    display: block;
    object-fit: contain;
  }
</style>
