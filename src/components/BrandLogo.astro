---
interface Props {
  class?: string;
  loading?: 'eager' | 'lazy';
  size?: string;
}

const { class: className, loading = 'lazy', size = '4rem' } = Astro.props;
---

<span class:list={['brand-logo', className]} style={`--logo-size:${size}`}>
  <img src="/IMG/logo-cl-potret.png?v=2" alt="CL Potret" loading={loading} decoding="async" />
</span>

<style>
  .brand-logo {
    display: block;
    width: var(--logo-size);
    aspect-ratio: 598 / 612;
  }

  .brand-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
