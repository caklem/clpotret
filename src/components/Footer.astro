---
import { site, whatsappUrl } from '../data/site';
---
<footer id="contact">
  <div class="container-wide foot-top">
    <div><p class="eyebrow">Photography in Malang</p><a href="/" class="display mark">CL Potret</a></div>
    <div class="nav"><a href="/portfolio">Portfolio</a><a href="/services">Services</a><a href="/pricing">Pricing</a><a href="/booking">Booking</a></div>
    <div class="social"><a href={site.instagramUrl} target="_blank">Instagram {site.instagram} ↗</a><a href={whatsappUrl()} target="_blank">WhatsApp ↗</a></div>
  </div>
  <div class="container-wide bottom"><span>© {new Date().getFullYear()} CL Potret</span><span>{site.location}</span><span>Moments, honestly framed.</span></div>
</footer>
<style>
  footer{background:#1d1c19;color:#f3f0e9;padding:clamp(4rem,8vw,7rem) 0 1.5rem}.foot-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem}.mark{display:block;font-size:clamp(4rem,10vw,9rem);margin-top:2rem}.nav,.social{display:flex;flex-direction:column;gap:1rem;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}.bottom{border-top:1px solid #ffffff26;margin-top:5rem;padding-top:1.25rem;display:flex;justify-content:space-between;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:#ffffff8f}
  @media(max-width:700px){.foot-top{grid-template-columns:1fr}.mark{font-size:4.2rem}.bottom{flex-direction:column;gap:.8rem}.nav,.social{border-top:1px solid #ffffff26;padding-top:1.5rem}}
</style>
