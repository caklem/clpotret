---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import CTASection from '../components/CTASection.astro';
import mainHero from '../assets/images/hero-main.jpg';
import { services } from '../data/services';
import { graduationPackages } from '../data/pricing';
import { featured } from '../data/featured';
import { site } from '../data/site';
const categoryItems = services.slice(0,6);
const igImages = [
  '/IMG/featured/_DSC0070.jpg',
  '/IMG/featured/_DSC0084.jpg',
  '/IMG/services/Wisuda1.jpg',
  '/IMG/services/Family.jpg',
  '/IMG/services/_DSC0171.jpg',
];
---
<Layout transparentNav>
  <section class="hero">
    <Image src={mainHero} alt="Portrait outdoor karya CL Potret di taman bunga matahari" widths={[640,960,1400,1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="shade"></div><div class="hero-copy"><p class="eyebrow">Photography · Malang</p><h1 class="display">Cerita yang<br/><em>layak</em><br class="mobile-break"/> diabadikan.</h1><div class="hero-bottom"><p>Graduation, portrait, dan outdoor photography dengan rasa yang natural dan personal.</p><div><a class="button button-light" href="/portfolio">View Portfolio</a><a class="text-link" href="/booking">Book a Session ↗</a></div></div></div>
    <div class="scroll">Scroll to discover <span>↓</span></div>
  </section>

  <section class="intro section-space container-copy" data-reveal><p class="eyebrow">What we remember</p><p class="display">Bukan hanya tentang terlihat indah. Kami memotret bagaimana sebuah momen <em>terasa.</em></p></section>

  <section class="featured container-wide section-space">
    <div class="section-head" data-reveal><div><p class="eyebrow">Selected stories · 2026</p><h2 class="display">Featured Work</h2></div><a class="link-line" href="/portfolio">Explore All Work</a></div>
    <PortfolioGrid items={featured} />
  </section>

  <section class="categories section-space"><div class="container-wide"><div class="section-head"><div><p class="eyebrow">Find your story</p><h2 class="display">Photography Sessions</h2></div></div><div class="category-grid">
    {categoryItems.map((item,i)=><a href="/services" class="category" data-reveal><Image src={item.image} alt={item.name} width={1200} height={1500} widths={[480,800]} sizes="(max-width: 800px) 50vw, 33vw" loading="lazy"/><span class="num">0{i+1}</span><div><h3 class="display">{item.name.replace(' Photography','').replace(' Session','')}</h3><p>{item.short}</p></div></a>)}
  </div></div></section>

  <section class="graduation"><div class="grad-image"><Image src="/IMG/graduation-hero.jpg" alt="Layanan fotografi wisuda CL Potret" width={1400} height={900} widths={[600,1000,1400]} sizes="(max-width: 800px) 100vw, 55vw" loading="lazy" /></div><div class="grad-copy" data-reveal><p class="eyebrow">Our signature session</p><h2 class="display">Graduation,<br/>your way.</h2><p>Setiap kelulusan punya cerita yang berbeda. Sesi kami dirancang agar kamu merasa nyaman, punya ruang untuk menjadi diri sendiri, dan pulang dengan foto yang benar-benar berarti.</p><a class="link-line" href="/portfolio?category=Graduation">Explore Graduation Sessions</a></div></section>

  <section id="about" class="about section-space container-wide"><div class="about-copy" data-reveal><p class="eyebrow">Behind the lens</p><h2 class="display">Hello, we’re<br/>CL Potret.</h2><p>CL Potret adalah layanan fotografi yang berbasis di Malang dan baru memulai perjalanan di dunia fotografi profesional, dengan fokus pada graduation, portrait, dan outdoor photography.</p><p>Kami terus belajar, berkembang, dan mengeksplorasi setiap momen melalui kamera. Bagi kami, sesi foto bukan sekadar tentang pose, tetapi tentang menciptakan suasana yang nyaman agar setiap ekspresi terasa lebih natural dan memiliki cerita.</p><a href={site.instagramUrl} target="_blank" class="link-line">Meet us on Instagram</a></div><div class="about-image"><Image src="/IMG/services/_DSC0171.jpg" alt="Fotografer CL Potret saat bekerja" width={1200} height={1500} widths={[600,900,1200]} sizes="(max-width: 800px) 100vw, 50vw" loading="lazy"/></div><span class="vertical">Natural · Personal · Honest</span></section>

  <section class="services-home section-space"><div class="container-copy"><p class="eyebrow">Ways to work with us</p><h2 class="display">Services</h2><div class="service-list">{services.map(item=><a href="/services" data-reveal><span>{item.number}</span><h3>{item.name}</h3><p>{item.short}</p><b>↗</b></a>)}</div></div></section>

  <section class="packages section-space container-wide"><div class="section-head"><div><p class="eyebrow">Graduation packages</p><h2 class="display">Choose your session</h2></div><a href="/pricing" class="link-line">View All Packages</a></div><div class="package-grid">{graduationPackages.map((item,i)=><PricingCard item={item} index={i}/>)}</div></section>

  <CTASection />

  <section class="instagram section-space container-wide"><div class="ig-head"><div><p class="eyebrow">Follow our stories</p><h2 class="display">{site.instagram}</h2></div><a href={site.instagramUrl} class="link-line" target="_blank">Follow on Instagram</a></div><div class="ig-grid">{igImages.map((src,i)=><a href={site.instagramUrl} target="_blank" class:list={{up:i===1||i===3}}><Image src={src} alt="CL Potret Instagram story" width={600} height={750} widths={[300,500]} sizes="20vw" loading="lazy"/></a>)}</div></section>
</Layout>
<style>
  .hero{height:max(720px,100svh);position:relative;color:white;overflow:hidden}.hero>img{height:100%;object-fit:cover;object-position:center 92%}.shade{position:absolute;inset:0;background:linear-gradient(90deg,#0c0b0985 0%,transparent 62%),linear-gradient(0deg,#0c0b0990,transparent 48%)}.hero-copy{position:absolute;inset:auto max(1rem,5vw) 9vh;max-width:1100px;min-width:0}.hero h1{font-size:clamp(3.8rem,9vw,9.2rem);margin:1rem 0 2rem}.mobile-break{display:none}.hero h1 em,.intro em{font-weight:400;color:#d9c6ae}.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem}.hero-bottom>p{max-width:400px;line-height:1.65}.hero-bottom>div{display:flex;align-items:center;gap:2rem}.text-link{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid}.scroll{position:absolute;right:2rem;bottom:2.5rem;writing-mode:vertical-rl;font-size:.58rem;letter-spacing:.15em;text-transform:uppercase}.scroll span{margin-top:1rem}
  .intro{text-align:center}.intro>.display{font-size:clamp(2.8rem,5.8vw,6.5rem);margin:2rem 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:clamp(3rem,7vw,7rem)}.section-head h2{font-size:clamp(3.5rem,7vw,7rem);margin:.8rem 0 0}
  .categories{background:#24231f;color:#f3f0e9}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#ffffff26}.category{height:55vh;min-height:440px;position:relative;overflow:hidden;background:#1d1c19}.category img{height:100%;object-fit:cover;opacity:.68;transition:.6s}.category:hover img{transform:scale(1.035);opacity:.48}.category>div{position:absolute;left:1.5rem;bottom:1.5rem}.category h3{font-size:clamp(2rem,4vw,4rem);margin:0 0 .4rem}.category p{margin:0;font-size:.72rem;opacity:.7}.num{position:absolute;right:1rem;top:1rem;font-size:.6rem;letter-spacing:.15em}
  .graduation{display:grid;grid-template-columns:55% 45%;background:#d8cdbd;min-height:85vh}.grad-image img{height:100%;object-fit:cover}.grad-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(3rem,8vw,9rem)}.grad-copy h2{font-size:clamp(4rem,7vw,7.5rem);margin:1.5rem 0 2rem}.grad-copy>p:not(.eyebrow){line-height:1.85;max-width:520px;margin-bottom:2.5rem}
  .about{display:grid;grid-template-columns:5fr 6fr auto;gap:clamp(2rem,7vw,8rem);align-items:center}.about-copy h2{font-size:clamp(4rem,7vw,7rem);margin:1.5rem 0 2rem}.about-copy>p:not(.eyebrow){line-height:1.8;color:#5f5b54}.about-copy .link-line{margin-top:1.5rem}.about-image img{height:75vh;min-height:600px;object-fit:cover}.vertical{writing-mode:vertical-rl;font-size:.6rem;text-transform:uppercase;letter-spacing:.2em}
  .services-home{background:#e5ded2}.services-home h2{font-size:clamp(4rem,8vw,8rem);margin:1rem 0 4rem}.service-list a{display:grid;grid-template-columns:50px 1.2fr 1fr auto;gap:2rem;align-items:center;border-top:1px solid #1d1c1945;padding:1.6rem 0}.service-list span{font-size:.65rem}.service-list h3{font-family:var(--font-display);font-size:clamp(1.7rem,3vw,2.8rem);font-weight:400;margin:0}.service-list p{font-size:.8rem;color:#6b665e}.service-list b{font-weight:400;transition:.2s}.service-list a:hover b{transform:translate(4px,-4px)}
  .package-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(2rem,5vw,6rem)}.ig-head{display:flex;justify-content:space-between;align-items:end}.ig-head h2{font-size:clamp(4rem,9vw,9rem);margin:1rem 0}.ig-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;align-items:start;margin-top:4rem}.ig-grid a{aspect-ratio:4/5;overflow:hidden}.ig-grid a.up{margin-top:4rem}.ig-grid img{height:100%;object-fit:cover;transition:.5s}.ig-grid a:hover img{transform:scale(1.03);filter:saturate(.7)}
  @media(min-width:801px) and (max-width:1100px){.hero-copy{bottom:5vh}.hero h1{font-size:clamp(5.2rem,9vw,6rem);max-width:850px}.hero-bottom{align-items:end}.hero-bottom>p{max-width:330px;font-size:.88rem}.hero-bottom>div{gap:1.25rem}.category-grid{grid-template-columns:repeat(2,1fr)}.category{height:62vh;min-height:500px}.graduation{grid-template-columns:48% 52%;min-height:720px}.grad-copy{padding:3.5rem}.grad-copy h2{font-size:clamp(4.5rem,7vw,5rem)}.about{grid-template-columns:.9fr 1.1fr;gap:3rem}.about-image img{height:65vh;min-height:500px}.about-copy h2{font-size:4.5rem}.vertical{display:none}.service-list a{grid-template-columns:42px 1.15fr .85fr auto;gap:1.25rem}.package-grid{gap:2rem}.ig-grid{gap:.75rem}}
  @media(max-width:800px){.hero>img{object-position:52% 92%}.scroll{display:none}.hero-copy{bottom:2rem}.hero h1{font-size:clamp(3.05rem,14vw,3.65rem);max-width:100%;white-space:normal}.mobile-break{display:block}.hero-bottom{display:block}.hero-bottom>div{margin-top:1.5rem;flex-wrap:wrap}.section-head,.ig-head{align-items:start;flex-direction:column;gap:2rem}.category-grid{grid-template-columns:1fr 1fr}.category{height:50vh;min-height:370px}.graduation{grid-template-columns:1fr}.grad-image{height:65vh}.about{grid-template-columns:1fr}.about-image{grid-row:1}.about-image img{height:65vh;min-height:0}.vertical{display:none}.service-list a{grid-template-columns:30px 1fr auto}.service-list p{display:none}.package-grid{grid-template-columns:1fr}.ig-grid{grid-template-columns:repeat(2,1fr)}.ig-grid a:nth-child(5){display:none}}
  @media(max-width:520px){.category-grid{grid-template-columns:1fr}.category{height:60vh}.hero-bottom>p{font-size:.86rem;max-width:330px}.hero .button{width:100%}.text-link{margin:auto}.service-list a{gap:1rem}.ig-grid{gap:.6rem}}
</style>
