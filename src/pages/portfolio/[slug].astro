---
import { Image } from 'astro:assets'; import Layout from '../../layouts/Layout.astro'; import CTASection from '../../components/CTASection.astro'; import { portfolio } from '../../data/portfolio';
export function getStaticPaths(){ return portfolio.map(item=>({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props;
const sessionValues = { Graduation:'Graduation Photography', Portrait:'Personal Portrait', Outdoor:'Outdoor / Hunting', Couple:'Couple Session', Family:'Family Session', Event:'Event Documentation' };
---
<Layout title={`${item.title} — CL Potret`} description={item.description}><header class="project-head container-wide"><div><p class="eyebrow">{item.category} · {item.location}</p><h1 class="display">{item.title}</h1></div><p>{item.description}</p></header><section class="cover"><Image src={item.image} alt={item.title} width={1800} height={1200} widths={[800,1200,1800]} sizes="100vw" /></section><section class="story container-copy"><p class="eyebrow">The story</p><p class="display">Foto yang baik memberi ruang untuk mengingat suasana, bukan hanya wajah.</p></section><section class="project-grid container-wide">{item.gallery.map((photo,i)=><figure class:list={{wide:i===0}}><Image src={photo} alt={`${item.title} gallery ${i+1}`} width={1400} height={1600} widths={[600,900,1400]} sizes={i===0?'100vw':'50vw'} loading="lazy"/></figure>)}</section><CTASection eyebrow="Plan a similar session" title="Love this style?" body="Bawa ceritamu sendiri. Kami akan membantu menerjemahkannya menjadi foto yang personal." buttonLabel="Book Similar Session" href={`/booking?session=${encodeURIComponent(sessionValues[item.category])}`} /></Layout>
<style>.project-head{padding:clamp(10rem,17vw,14rem) 0 5rem;display:flex;justify-content:space-between;align-items:end;gap:3rem}.project-head h1{font-size:clamp(4rem,9vw,9rem);margin:1rem 0 0}.project-head>p{max-width:430px;line-height:1.8}.cover{height:90vh;min-height:650px}.cover img{height:100%;object-fit:cover}.story{text-align:center;padding:8rem 0}.story .display{font-size:clamp(2.8rem,5vw,5.5rem);margin:2rem 0}.project-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1rem,3vw,3rem);padding-bottom:10rem}.project-grid figure{margin:0}.project-grid figure.wide{grid-column:1/-1}.project-grid img{height:75vh;object-fit:cover}.project-grid .wide img{height:80vh}@media(max-width:700px){.project-head{align-items:start;flex-direction:column}.cover{height:70vh;min-height:0}.project-grid{grid-template-columns:1fr}.project-grid figure.wide{grid-column:auto}.project-grid img,.project-grid .wide img{height:62vh}}</style>
