---
import Layout from '../../layouts/Layout.astro'; import PortfolioGrid from '../../components/PortfolioGrid.astro'; import CTASection from '../../components/CTASection.astro';
---
<Layout title="Portfolio — CL Potret"><header class="page-head container-wide"><p class="eyebrow">Selected stories · Malang</p><h1 class="display">People, moments,<br/><em>honestly framed.</em></h1><p>Graduation, portrait, dan cerita-cerita personal yang kami abadikan dalam cahaya alami.</p></header><section class="container-wide gallery"><PortfolioGrid interactive /></section><CTASection title="Love this style?" body="Mari buat sesi dengan rasa yang sama—namun sepenuhnya tentang ceritamu." /></Layout>
<style>.page-head{padding-top:clamp(9rem,17vw,13rem);padding-bottom:clamp(5rem,9vw,9rem)}h1{font-size:clamp(3.8rem,9vw,9rem);margin:1.5rem 0 2rem}h1 em{color:#9a7658;font-weight:400}.page-head>p:last-child{max-width:470px;line-height:1.8;margin-left:auto}.gallery{padding-bottom:10rem}</style>
