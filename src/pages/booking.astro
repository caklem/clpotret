---
import Layout from '../layouts/Layout.astro'; import BookingForm from '../components/BookingForm.astro';
---
<Layout title="Booking Session — CL Potret"><div class="booking"><header><p class="eyebrow">Start a conversation</p><h1 class="display">Let’s plan<br/><em>your session.</em></h1><p>Isi detail singkat di bawah. Setelah itu, kamu akan diarahkan ke WhatsApp untuk memastikan jadwal dan membicarakan konsep bersama kami.</p></header><section><BookingForm /></section></div><aside><p class="eyebrow">Before you book</p><ol><li><span>01</span><div><h2>Pilih sesi</h2><p>Tentukan layanan dan paket yang paling sesuai.</p></div></li><li><span>02</span><div><h2>Ceritakan idemu</h2><p>Tidak harus matang—kami bantu mengembangkannya.</p></div></li><li><span>03</span><div><h2>Konfirmasi jadwal</h2><p>Kami akan membalas ketersediaan melalui WhatsApp.</p></div></li></ol></aside></Layout>
<style>.booking{padding:clamp(9rem,15vw,13rem) max(1rem,6vw) 8rem;display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(4rem,10vw,12rem)}header h1{font-size:clamp(4rem,7vw,7.5rem);margin:1.5rem 0 2rem}header h1 em{color:#9a7658;font-weight:400}header>p:last-child{line-height:1.8;color:#68645d}aside{background:#d8cdbd;padding:clamp(4rem,8vw,8rem) max(1rem,12vw)}ol{list-style:none;padding:0;margin:3rem 0 0}li{display:grid;grid-template-columns:50px 1fr;border-top:1px solid #1d1c1940;padding:1.4rem 0}li>span{font-size:.65rem}li h2{font-family:var(--font-display);font-weight:400;font-size:2rem;margin:0 0 .5rem}li p{margin:0;color:#68645d;font-size:.85rem}@media(min-width:851px) and (max-width:1100px){.booking{padding-inline:3rem;grid-template-columns:.85fr 1.15fr;gap:4rem}.booking header h1{font-size:4.5rem}}@media(max-width:850px){.booking{grid-template-columns:1fr;gap:4rem}}</style>
