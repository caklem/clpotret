---
import { Image } from 'astro:assets'; import Layout from '../layouts/Layout.astro'; import CTASection from '../components/CTASection.astro'; import { services } from '../data/services';
---
<Layout title="Photography Services — CL Potret"><header class="page-head container-wide"><p class="eyebrow">Ways to work with us</p><h1 class="display">Photography for<br/><em>your kind of story.</em></h1></header><section class="services container-wide">{services.map((item,i)=><article class:list={{reverse:i%2}} data-reveal><div class="photo"><Image src={item.image} alt={item.name} width={1200} height={1500} widths={[600,900,1200]} sizes="(max-width: 750px) 100vw, 55vw" loading="lazy"/></div><div class="copy"><span class="eyebrow">{item.number}</span><h2 class="display">{item.name}</h2><h3>{item.short}</h3><p>{item.description}</p><a href={`/booking?session=${encodeURIComponent(item.name)}`} class="link-line">Plan this session</a></div></article>)}</section><CTASection /></Layout>
<style>.page-head{padding:clamp(10rem,17vw,15rem) 0 clamp(6rem,10vw,10rem)}h1{font-size:clamp(4rem,9vw,9rem);margin:1rem 0}h1 em{color:#9a7658;font-weight:400}.services{padding-bottom:10rem}.services article{display:grid;grid-template-columns:1.15fr .85fr;min-height:75vh;margin-bottom:clamp(6rem,12vw,13rem);align-items:center;gap:clamp(3rem,9vw,10rem)}.services article.reverse{grid-template-columns:.85fr 1.15fr}.services article.reverse .photo{order:2}.photo img{height:75vh;min-height:600px;object-fit:cover}.copy h2{font-size:clamp(3.5rem,6vw,6.5rem);margin:1.5rem 0}.copy h3{font-family:var(--font-display);font-size:1.7rem;font-weight:400}.copy>p{line-height:1.85;color:#666159;margin:1.5rem 0 2.5rem}@media(min-width:751px) and (max-width:1100px){.page-head{padding-bottom:7rem}.services article,.services article.reverse{grid-template-columns:1fr 1fr;gap:4rem;min-height:650px;margin-bottom:8rem}.photo img{height:65vh;min-height:500px}.copy h2{font-size:3.7rem}}@media(max-width:750px){.services article,.services article.reverse{grid-template-columns:1fr;min-height:0;gap:2.5rem}.services article.reverse .photo{order:0}.photo img{height:65vh;min-height:0}}</style>
