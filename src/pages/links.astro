---
import { Image } from 'astro:assets'; import Layout from '../layouts/Layout.astro'; import hero from '../assets/images/graduation-hero.png'; import { site, whatsappUrl } from '../data/site';
const links=[['Booking Foto','/booking'],['Portfolio','/portfolio'],['Paket Wisuda','/pricing'],['Services','/services'],['WhatsApp',whatsappUrl()],['Instagram '+site.instagram,site.instagramUrl]];
---
<Layout title="CL Potret — Links" hideChrome><div class="links-page"><div class="portrait"><Image src={hero} alt="CL Potret photography" widths={[480,800]} sizes="(max-width: 700px) 100vw, 42vw" loading="eager" /></div><main><a class="brand" href="/"><span>CL</span><strong class="display">Potret</strong></a><p class="eyebrow">Photography in Malang</p><h1 class="display">Moments,<br/><em>honestly framed.</em></h1><nav>{links.map(([label,href],i)=><a href={href} target={href.startsWith('http')?'_blank':undefined}><small>0{i+1}</small><span>{label}</span><b>↗</b></a>)}</nav><footer>© {new Date().getFullYear()} CL Potret · Malang</footer></main></div></Layout>
<style>.links-page{min-height:100svh;background:#1d1c19;color:#f3f0e9;display:grid;grid-template-columns:42% 58%}.portrait{height:100svh;position:sticky;top:0}.portrait img{height:100%;object-fit:cover}.links-page>main{padding:clamp(2rem,6vw,7rem);display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:.5rem}.brand span{font-size:.65rem;border:1px solid;padding:.25rem}.brand strong{font-size:2rem;font-weight:400}h1{font-size:clamp(3.5rem,7vw,7rem);margin:2rem 0 auto}h1 em{font-weight:400;color:#cbb9a3}main>.eyebrow{margin-top:4rem;color:#ffffff80}nav{margin:4rem 0}nav a{display:grid;grid-template-columns:40px 1fr auto;align-items:center;border-top:1px solid #ffffff30;padding:1rem 0;transition:padding .2s}nav a:hover{padding-left:.5rem}nav small{font-size:.55rem;color:#ffffff70}nav span{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.4rem)}nav b{font-weight:400}footer{font-size:.58rem;text-transform:uppercase;letter-spacing:.15em;color:#ffffff70}@media(max-width:700px){.links-page{grid-template-columns:1fr}.portrait{height:38svh;position:relative}.links-page>main{min-height:62svh;padding:1.5rem}.brand{position:absolute;top:1.5rem;color:white}.brand strong{font-size:1.8rem}main>.eyebrow{margin-top:1rem}h1{font-size:3.3rem;margin:1.3rem 0 2rem}nav{margin:0 0 2rem}nav a{padding:.8rem 0}nav span{font-size:1.55rem}}</style>
