---
import Layout from '../layouts/Layout.astro'; import PricingCard from '../components/PricingCard.astro'; import CTASection from '../components/CTASection.astro'; import { packages, startingPrices } from '../data/pricing';
---
<Layout title="Paket & Harga — CL Potret"><header class="page-head container-wide"><p class="eyebrow">Simple, thoughtful packages</p><div><h1 class="display">Invest in what<br/><em>you’ll remember.</em></h1><p>Setiap paket dirancang agar sesi berjalan santai dan kamu mendapat cukup ruang untuk bercerita.</p></div></header><section class="graduation-price container-wide"><div class="heading"><p class="eyebrow">01 · Graduation</p><h2 class="display">Graduation packages</h2></div><div class="grid">{packages.map((item,i)=><PricingCard item={item} index={i}/>)}</div><p class="note">* Harga masih berupa placeholder dan dapat berubah sesuai lokasi, tanggal, serta kebutuhan sesi.</p></section><section class="other section-space"><div class="container-copy"><div class="heading"><p class="eyebrow">02 · Other sessions</p><h2 class="display">More ways to create</h2></div>{startingPrices.map(([name,price])=><a href={`/booking?session=${encodeURIComponent(name)}`}><h3 class="display">{name}</h3><span>{price}</span><b>↗</b></a>)}</div></section><CTASection /></Layout>
<style>.page-head{padding:clamp(10rem,17vw,14rem) 0 7rem}.page-head>div{display:flex;justify-content:space-between;align-items:end;gap:3rem}.page-head h1{font-size:clamp(4rem,9vw,9rem);margin:1.2rem 0 0}.page-head h1 em{color:#9a7658;font-weight:400}.page-head div>p{max-width:400px;line-height:1.8}.graduation-price{padding-bottom:10rem}.heading h2{font-size:clamp(3.4rem,7vw,7rem);margin:1rem 0 5rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(2rem,5vw,6rem)}.note{font-size:.68rem;color:#777268;margin-top:2rem}.other{background:#ded5c8}.other a{display:grid;grid-template-columns:1fr auto 30px;align-items:center;border-top:1px solid #1d1c1950;padding:1.5rem 0;gap:2rem}.other h3{font-size:clamp(2rem,4vw,4rem);margin:0}.other span{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.other b{font-weight:400}@media(max-width:750px){.page-head>div{align-items:start;flex-direction:column}.grid{grid-template-columns:1fr}.other a{grid-template-columns:1fr auto}.other b{display:none}}</style>
