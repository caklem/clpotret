---
import Layout from '../layouts/Layout.astro';
import PricingCard from '../components/PricingCard.astro';
import CTASection from '../components/CTASection.astro';
import {
  graduationPackages,
  graduationAddOns,
  generalPackages,
  generalAddOns,
} from '../data/pricing';
---
<Layout title="Paket & Harga — CL Potret">
  <!-- Header -->
  <header class="page-head container-wide">
    <p class="eyebrow">Price List 2026</p>
    <div>
      <h1 class="display">Invest in what<br/><em>you'll remember.</em></h1>
      <p>Setiap paket dirancang agar sesi berjalan santai dan kamu mendapat cukup ruang untuk bercerita.</p>
    </div>
  </header>

  <!-- Graduation Photography -->
  <section class="pricing-section container-wide">
    <div class="heading">
      <p class="eyebrow">Graduation Photography</p>
      <h2 class="display">Graduation packages</h2>
      <p class="section-desc">Capture your graduation moment with elegant and timeless portraits.</p>
    </div>
    <div class="grid grid-3">
      {graduationPackages.map((item, i) => (
        <PricingCard item={item} index={i} />
      ))}
    </div>
    <div class="addon-section">
      <h3>Graduation Add-On</h3>
      <div class="addon-grid">
        {graduationAddOns.map(addon => (
          <div class="addon-item">
            <span class="addon-name">{addon.name}</span>
            <span class="addon-price">{addon.price}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- General Photography -->
  <section class="pricing-section general-section">
    <div class="container-wide">
      <div class="heading">
        <p class="eyebrow">General Photography</p>
        <h2 class="display">More sessions</h2>
        <p class="section-desc">Flexible sessions for personal, outdoor, couple, and event moments.</p>
      </div>
      <div class="grid grid-3">
        {generalPackages.slice(0, 3).map((item, i) => (
          <PricingCard item={item} index={i} />
        ))}
      </div>
      <!-- Travel / Outdoor as wide card -->
      <div class="wide-card">
        <PricingCard item={generalPackages[3]} index={3} />
      </div>
      <div class="addon-section">
        <h3>General Add-On</h3>
        <div class="addon-grid">
          {generalAddOns.map(addon => (
            <div class="addon-item">
              <span class="addon-name">{addon.name}</span>
              <span class="addon-price">{addon.price}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .page-head {
    padding: clamp(10rem, 17vw, 14rem) 0 7rem;
  }
  .page-head > div {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3rem;
  }
  .page-head h1 {
    font-size: clamp(4rem, 9vw, 9rem);
    margin: 1.2rem 0 0;
  }
  .page-head h1 em {
    color: #9a7658;
    font-weight: 400;
  }
  .page-head div > p {
    max-width: 400px;
    line-height: 1.8;
  }

  /* Pricing sections */
  .pricing-section {
    padding-bottom: 8rem;
  }
  .general-section {
    background: #f5f1eb;
    padding-top: 8rem;
  }
  .heading h2 {
    font-size: clamp(3.4rem, 7vw, 7rem);
    margin: 1rem 0 4rem;
  }
  .section-desc {
    font-size: .95rem;
    color: #68645d;
    max-width: 480px;
    line-height: 1.7;
    margin-top: -2rem;
  }

  /* Grid */
  .grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Wide card for Travel/Outdoor */
  .wide-card {
    margin-top: clamp(2rem, 4vw, 4rem);
    max-width: 600px;
  }
  .wide-card :global(.price) {
    border-top: 1px solid #1d1c19;
  }

  /* Add-on */
  .addon-section {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid #1d1c1930;
  }
  .addon-section h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    margin: 0 0 1.5rem;
    color: #1d1c19;
  }
  .addon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .addon-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: .8rem 0;
    border-bottom: 1px solid #1d1c1915;
    font-size: .88rem;
  }
  .addon-name {
    color: #1d1c19;
  }
  .addon-price {
    font-family: var(--font-display);
    font-size: 1rem;
    color: #1d1c19;
    white-space: nowrap;
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
    .page-head > div {
      flex-direction: column;
      align-items: start;
    }
  }
  @media (max-width: 750px) {
    .addon-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
